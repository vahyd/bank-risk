# Copy to .env and adjust as needed.
DATABASE_URL=sqlite:///./data/app.db
# DATABASE_URL=postgresql+psycopg://bank:bank@localhost:5432/bankrisk

# Open-source LLM via Ollama (Llama 3.1 / Mistral)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
LLM_FALLBACK=true

# Synthetic data
N_CUSTOMERS=120
N_ACCOUNTS=260
N_TRANSACTIONS=28000
N_FACILITIES=110
SEED=42

# Risk thresholds
AML_REPORTING_THRESHOLD=10000
FRAUD_ALERT_THRESHOLD=0.75
AML_ALERT_THRESHOLD=0.70
